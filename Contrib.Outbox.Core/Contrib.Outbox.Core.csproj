<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Contrib.Outbox.Core</RootNamespace>
    <AssemblyName>Contrib.Outbox.Core</AssemblyName>
    <PackageId>Contrib.Outbox.Core</PackageId>
    <Description>Moteur agnostique du pattern Transactional Outbox (polling, locking, publication). Ne dépend d'aucune base de données : brancher un provider (Contrib.Outbox.Mongo, .Sql, .Redis, ou une implémentation maison de IOutboxStore).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <InternalsVisibleTo Include="Contrib.Outbox.Core.Tests" />
  </ItemGroup>

</Project>
